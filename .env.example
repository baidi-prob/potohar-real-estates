# Copy this file to .env.local for local development, or add these variables
# in Vercel: Project Settings -> Environment Variables.
# Values: Supabase Dashboard -> Project Settings -> API

# e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project-ref.supabase.co

# The "anon public" API key (safe for browsers; RLS protects the data).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Public site URL (used for sitemap.xml, canonical + Open Graph URLs).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only Supabase admin key. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Server-only HMAC secret used to hash email OTPs.
OTP_HASH_SECRET=replace-with-a-long-random-secret

# Resend email delivery (server-only).
RESEND_API_KEY=re_your-resend-api-key
RESEND_FROM_EMAIL=Potohar Real Estates <noreply@your-verified-domain.com>
