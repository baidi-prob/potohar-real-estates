# Copy this file to .env.local and fill in your Supabase project values.
# Get them from: Supabase Dashboard -> Project Settings -> API
#   (left sidebar: Project Settings > API)

# e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# The "anon public" API key. It is safe for browsers because Row Level
# Security (RLS) in the database controls what each user can read/write.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Public site URL. Used for sitemap.xml, canonical URLs and Open Graph tags.
# Use your local dev server while developing, and your production domain
# (e.g. https://potohar-real-estates.vercel.app) in Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only values. Do not use NEXT_PUBLIC_ for these secrets.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
OTP_HASH_SECRET=replace-with-a-long-random-secret
RESEND_API_KEY=re_your-resend-api-key
RESEND_FROM_EMAIL=Potohar Real Estates <noreply@your-verified-domain.com>
